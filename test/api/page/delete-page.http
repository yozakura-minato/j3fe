### deletePage_success
DELETE {{HOST}}/api/v1
    /pages/01a06669-e82b-779f-beec-a102fde4adf4

> {%
    client.test("SHOULD return success WHEN page ID is valid", () => {
        client.assert(response.status === 200);

        client.assert(response.body === null);
    });
%}

### deletePage_pageNotFound
DELETE {{HOST}}/api/v1
    /pages/{{BAD_UUID}}

> {%
    client.test("SHOULD return error WHEN page ID not found", () => {
        client.assert(response.status === 404);

        client.assert(response.body !== null);
        client.assert(response.body.error === "page.id.notFound");

        client.assert(response.body.data === null);
    })
%}
